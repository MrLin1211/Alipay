PAYMENT_GATEWAY_PORT=8090

# 本地开发可以先复用现有 alipay_pay 数据库；生产环境建议单独创建 payment_gateway 数据库。
GATEWAY_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/alipay_pay?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
GATEWAY_DATASOURCE_USERNAME=alipay_user
GATEWAY_DATASOURCE_PASSWORD=alipay123456

# 默认管理后台账号，仅在管理员表为空时初始化。
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=admin123456

# 业务系统调用网关的演示应用。
GATEWAY_DEMO_APP_ENABLED=true
GATEWAY_DEMO_APP_ID=biz-demo
GATEWAY_DEMO_APP_SECRET=demo-secret-change-me
