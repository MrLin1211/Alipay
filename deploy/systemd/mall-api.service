[Unit]
Description=Alipay Mall API
After=network.target mysql.service

[Service]
User=alipay
WorkingDirectory=/opt/alipay
EnvironmentFile=/etc/alipay/alipay.env
Environment=SERVER_PORT=8080
ExecStart=/usr/bin/java -jar /opt/alipay/mall-api.jar
Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
