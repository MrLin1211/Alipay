[client]
port=13306
socket=/opt/alipay-gateway-chengxinkeji/mysql/mysql.sock
default-character-set=utf8mb4

[mysqld]
basedir=/www/server/mysql
datadir=/opt/alipay-gateway-chengxinkeji/mysql/data
port=13306
bind-address=127.0.0.1
socket=/opt/alipay-gateway-chengxinkeji/mysql/mysql.sock
pid-file=/opt/alipay-gateway-chengxinkeji/mysql/mysql.pid
log-error=/opt/alipay-gateway-chengxinkeji/mysql/mysql-error.log
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
skip-name-resolve
performance-schema=OFF
innodb-buffer-pool-size=128M
innodb-log-file-size=32M
max-connections=60
table-open-cache=256
thread-cache-size=8
key-buffer-size=8M
tmp-table-size=16M
max-heap-table-size=16M
max-allowed-packet=16M
sql-mode=STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION
explicit-defaults-for-timestamp=ON

[mysqldump]
quick
max-allowed-packet=16M
