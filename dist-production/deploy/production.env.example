# Copy this file to /etc/alipay/alipay.env on the production server.
# Replace every CHANGE_ME value before starting services.

SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1

SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/alipay_pay?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=alipay_user
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_DB_PASSWORD

GATEWAY_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/alipay_pay?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
GATEWAY_DATASOURCE_USERNAME=alipay_user
GATEWAY_DATASOURCE_PASSWORD=CHANGE_ME_DB_PASSWORD

MALLHOME_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/alipay_pay?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MALLHOME_DATASOURCE_USERNAME=alipay_user
MALLHOME_DATASOURCE_PASSWORD=CHANGE_ME_DB_PASSWORD

APP_UPLOAD_DIR=/var/www/alipay/uploads

MALLHOME_PAY_HOST=https://api.linsy.online
MALLHOME_NOTIFY_URL=https://api.linsy.online/api/merchant/gateway/pay/notify
MALLHOME_RETURN_URL=https://mall.linsy.online/pay-result
PAYMENT_GATEWAY_HOST=http://127.0.0.1:8090
PAYMENT_GATEWAY_APP_ID=biz-demo
PAYMENT_GATEWAY_APP_SECRET=CHANGE_ME_GATEWAY_APP_SECRET

MALLHOME_MD5_KEY=CHANGE_ME_MD5_KEY
MALLHOME_AES_KEY=CHANGE_ME_AES_KEY
MALLHOME_EXTERNAL_ID=CHANGE_ME_EXTERNAL_ID

GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
GATEWAY_DEMO_APP_ENABLED=false
