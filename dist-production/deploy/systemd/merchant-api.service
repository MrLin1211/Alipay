[Unit]
Description=Alipay Merchant API
After=network.target mysql.service

[Service]
User=alipay
WorkingDirectory=/opt/alipay
EnvironmentFile=/etc/alipay/common.env
Environment=SERVER_PORT=8081
ExecStart=/usr/bin/java -jar /opt/alipay/merchant-api.jar
Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
